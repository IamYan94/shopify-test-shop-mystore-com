{%- comment -%}
Універсальний банер продукту (без локалізацій).
Передача:
  {% render 'banner-product', handle: 'nike-air-max-plus' %}
або:
  {% render 'banner-product', product: product %}

Показує: фото, назву, ціну (зі знижкою), перші 3 кольори, індикатор наявності.
{%- endcomment -%}

{%- assign p = product -%}
{%- unless p -%}
  {%- if handle -%}{%- assign p = all_products[handle] -%}{%- endif -%}
{%- endunless -%}

{%- if p == nil -%}
<div class="bp-wrap"><div class="bp-msg">Product not found</div></div>
{%- endif -%}
{%- if p -%}

{%- comment -%} Визначаємо індекс опції Color/Colour. Якщо нема — беремо першу опцію. {%- endcomment -%}
{%- assign color_index = -1 -%}
{%- for opt in p.options_with_values -%}
  {%- assign dn = opt.name | downcase -%}
  {%- if dn == 'color' or dn == 'colour' -%}{%- assign color_index = forloop.index0 -%}{%- break -%}{%- endif -%}
{%- endfor -%}
{%- if color_index == -1 -%}{%- assign color_index = 0 -%}{%- endif -%}

{%- case color_index -%}
  {%- when 0 -%}{%- assign colors_all = p.variants | map: 'option1' -%}
  {%- when 1 -%}{%- assign colors_all = p.variants | map: 'option2' -%}
  {%- when 2 -%}{%- assign colors_all = p.variants | map: 'option3' -%}
{%- endcase -%}
{%- assign colors = colors_all | uniq -%}

{%- capture price_block -%}
  {%- if p.price -%}
    {%- assign current_price = p.price -%}
    {%- assign compare_price = p.compare_at_price_max -%}
    {%- if compare_price and compare_price > current_price -%}
      <div class="bp-price">
        <span class="bp-price-sale">{{ current_price | money_without_trailing_zeros }}</span>
        <span class="bp-price-compare">{{ compare_price | money_without_trailing_zeros }}</span>
      </div>
    {%- else -%}
      <div class="bp-price">
        <span class="bp-price-regular">{{ current_price | money_without_trailing_zeros }}</span>
      </div>
    {%- endif -%}
  {%- endif -%}
{%- endcapture -%}

{%- assign img = p.featured_image -%}
{%- assign alt_text = img.alt | default: p.title | escape -%}

<div class="bp-wrap" data-banner="product" data-pid="{{ p.id }}">
  <div class="bp-left">
    {%- if img -%}
      {{ img | image_url: width: 980 | image_tag: alt: alt_text, class: 'bp-img' }}
    {%- else -%}
      <div class="bp-placeholder" aria-label="{{ alt_text }}">No image</div>
    {%- endif -%}
  </div>

  <div class="bp-right">
    <div class="bp-vendor">
      <span class="bp-badge">{{ p.vendor | escape }}</span>
    </div>

    <h3 class="bp-title">{{ p.title | escape }}</h3>
    {{- price_block -}}

    <div class="bp-colors">
      <div class="bp-colors-label">Select color</div>

      {%- if colors and colors != blank -%}
        <div class="bp-color-list">
          {%- assign rendered = 0 -%}
          {%- for c in colors -%}
            {%- if c == blank -%}{%- continue -%}{%- endif -%}
            {%- if rendered >= 3 -%}{%- break -%}{%- endif -%}

            {%- assign v_match = nil -%}
            {%- for v in p.variants -%}
              {%- if color_index == 0 and v.option1 == c -%}{%- assign v_match = v -%}{%- break -%}{%- endif -%}
              {%- if color_index == 1 and v.option2 == c -%}{%- assign v_match = v -%}{%- break -%}{%- endif -%}
              {%- if color_index == 2 and v.option3 == c -%}{%- assign v_match = v -%}{%- break -%}{%- endif -%}
            {%- endfor -%}

            {%- if v_match -%}
              {%- assign qty = 0 -%}
              {%- if v_match.inventory_management -%}
                {%- assign qty = v_match.inventory_quantity | default: 0 -%}
              {%- else -%}
                {%- if v_match.available -%}{%- assign qty = 1 -%}{%- else -%}{%- assign qty = 0 -%}{%- endif -%}
              {%- endif -%}
              <button type="button"
                      class="bp-color"
                      data-variant-id="{{ v_match.id }}"
                      data-color="{{ c | escape }}"
                      data-qty="{{ qty }}"
                      data-available="{{ v_match.available }}"
                      aria-label="{{ c | escape }}">
                <span class="bp-swatch">{{ c | escape }}</span>
              </button>
              {%- assign rendered = rendered | plus: 1 -%}
            {%- endif -%}

          {%- endfor -%}
        </div>
      {%- else -%}
        <div class="bp-msg">No color options available</div>
      {%- endif -%}
    </div>

    <div class="bp-stock" data-stock
         data-not-available="Not available"
         data-available-with-count="Available: %{count}">
    </div>

    <div class="bp-cta">
      <a class="bp-link" href="{{ p.url }}">View product</a>
    </div>
  </div>
</div>

<style>
.bp-wrap{display:grid;grid-template-columns:1fr 1fr;gap:28px;align-items:start;border:1px solid #e5e7eb;border-radius:16px;padding:20px}
.bp-img{width:100%;height:auto;border-radius:12px;display:block;object-fit:cover}
.bp-placeholder{display:flex;align-items:center;justify-content:center;background:#f3f4f6;border-radius:12px;min-height:320px;font-weight:600}
.bp-title{font-size:24px;line-height:1.2;margin:8px 0 6px}
.bp-price{display:flex;gap:10px;align-items:center;margin-bottom:12px}
.bp-price-regular,.bp-price-sale{font-weight:700}
.bp-price-sale{font-size:20px}
.bp-price-compare{text-decoration:line-through;opacity:.6}
.bp-badge{display:inline-block;font-size:12px;padding:4px 8px;border:1px solid #e5e7eb;border-radius:999px;margin-bottom:6px}
.bp-colors-label{font-size:14px;opacity:.8;margin-bottom:8px}
.bp-color-list{display:flex;gap:10px;flex-wrap:wrap}
.bp-color{border:1px solid #e5e7eb;border-radius:10px;padding:8px 12px;background:#fff;cursor:pointer;transition:box-shadow .15s ease}
.bp-color:hover{box-shadow:0 2px 10px rgba(0,0,0,.06)}
.bp-color[aria-selected="true"]{outline:2px solid #111}
.bp-swatch{display:inline-block;min-width:48px;text-align:center}
.bp-stock{margin-top:10px;font-size:14px;min-height:20px}
.bp-msg{font-size:14px;color:#b91c1c}
.bp-link{display:inline-block;margin-top:14px;padding:10px 14px;border-radius:10px;background:#111;color:#fff;text-decoration:none}
@media(max-width:940px){.bp-wrap{grid-template-columns:1fr}}
</style>

<script>
(function(){
  var here=document.currentScript;
  var wrap=null, ptr=here;
  while(ptr){ if(ptr.previousElementSibling && ptr.previousElementSibling.matches('.bp-wrap')){ wrap=ptr.previousElementSibling; break } ptr=ptr.previousElementSibling }
  if(!wrap) wrap=document.querySelector('.bp-wrap[data-banner="product"]');
  if(!wrap) return;

  var list=[].slice.call(wrap.querySelectorAll('.bp-color'));
  var stock=wrap.querySelector('[data-stock]');

  function fmt(q){
    return stock.getAttribute('data-available-with-count').replace('%{count}', q);
  }

  function show(btn){
    list.forEach(function(b){ b.setAttribute('aria-selected','false'); });
    btn.setAttribute('aria-selected','true');
    var qty=parseInt(btn.dataset.qty,10);
    var avail=(btn.dataset.available==='true') || qty>0;
    if(!avail || qty<=0){
      stock.textContent=stock.getAttribute('data-not-available');
    }else{
      stock.textContent=(Number.isFinite(qty) && qty>0) ? fmt(qty) : fmt('1+');
    }
  }

  if(list.length){
    var noneHaveQty=true;
    list.forEach(function(b){ if((parseInt(b.dataset.qty,10)||0)>0) noneHaveQty=false; });
    if(noneHaveQty){ var last=list[list.length-1]; if(last){ last.dataset.qty='0'; last.dataset.available='false'; } }
    show(list[0]);
    list.forEach(function(b){ b.addEventListener('click', function(){ show(b); }); });
  }
})();
</script>
{%- endif -%}


