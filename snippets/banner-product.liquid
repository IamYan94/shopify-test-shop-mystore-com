{%- assign p = product -%}
{%- unless p -%}{% if handle %}{%- assign p = all_products[handle] -%}{% endif %}{%- endunless -%}

{%- if p == nil -%}
<div class="bp-card"><div class="bp-msg">Product not found</div></div>
{%- endif -%}
{%- if p -%}

{%- assign color_index = -1 -%}
{%- assign size_index = -1 -%}
{%- for opt in p.options_with_values -%}
  {%- assign dn = opt.name | downcase -%}
  {%- if dn == 'color' or dn == 'colour' -%}{%- assign color_index = forloop.index0 -%}{%- endif -%}
{%- endfor -%}
{%- if color_index == -1 -%}{%- assign color_index = 0 -%}{%- endif -%}

{%- for opt in p.options_with_values -%}
  {%- assign dn = opt.name | downcase -%}
  {%- if forloop.index0 != color_index and (dn == 'size' or dn == 'розмір' or dn == 'shoe size') -%}
    {%- assign size_index = forloop.index0 -%}
  {%- endif -%}
{%- endfor -%}
{%- if size_index == -1 and p.options_with_values.size > 1 -%}
  {%- for opt in p.options_with_values -%}
    {%- if forloop.index0 != color_index -%}{%- assign size_index = forloop.index0 -%}{%- break -%}{%- endif -%}
  {%- endfor -%}
{%- endif -%}

{%- case color_index -%}
  {%- when 0 -%}{%- assign colors_all = p.variants | map: 'option1' -%}
  {%- when 1 -%}{%- assign colors_all = p.variants | map: 'option2' -%}
  {%- when 2 -%}{%- assign colors_all = p.variants | map: 'option3' -%}
{%- endcase -%}
{%- assign colors = colors_all | uniq -%}

{%- assign main_img = p.featured_media | default: p.featured_image -%}
{%- assign images = p.images -%}
{%- assign alt_text = main_img.alt | default: p.title | escape -%}

{%- capture matrix_json -%}
{ "variants": [
{%- for v in p.variants -%}
  {%- assign v_color = '' -%}
  {%- assign v_size = '' -%}
  {%- if color_index == 0 -%}{%- assign v_color = v.option1 -%}{%- elsif color_index == 1 -%}{%- assign v_color = v.option2 -%}{%- else -%}{%- assign v_color = v.option3 -%}{%- endif -%}
  {%- if size_index != -1 -%}
    {%- if size_index == 0 -%}{%- assign v_size = v.option1 -%}{%- elsif size_index == 1 -%}{%- assign v_size = v.option2 -%}{%- else -%}{%- assign v_size = v.option3 -%}{%- endif -%}
  {%- endif -%}
  {%- assign qty = 0 -%}
  {%- if v.inventory_management -%}
    {%- assign qty = v.inventory_quantity | default: 0 -%}
  {%- else -%}
    {%- if v.available -%}{%- assign qty = 1 -%}{%- endif -%}
  {%- endif -%}
  {%- assign thumb = v.image | default: p.featured_image -%}
  { 
    "id": {{ v.id }},
    "color": {{ v_color | json }},
    "size": {{ v_size | json }},
    "available": {{ v.available | json }},
    "qty": {{ qty | json }},
    "img": {{ thumb | image_url: width: 120, height: 120, crop: 'center' | json }}
  }{% unless forloop.last %},{% endunless %}
{%- endfor -%}
] }
{%- endcapture -%}

<div class="bp-card" data-banner="product" data-pid="{{ p.id }}">
  <div class="bp-media">
    <div class="bp-thumbs">
      {%- assign thumb_count = 0 -%}
      {%- for im in images -%}
        {%- if thumb_count >= 5 -%}{%- break -%}{%- endif -%}
        <button type="button"
          class="bp-thumb{% if forloop.first %} is-active{% endif %}"
          data-full="{{ im | image_url: width: 1600 }}"
          aria-label="thumb {{ forloop.index }}">
          {{- im | image_url: width: 120, height: 120, crop: 'center' | image_tag: alt: (im.alt | default: p.title), class: 'bp-thumb-img' -}}
        </button>
        {%- assign thumb_count = thumb_count | plus: 1 -%}
      {%- endfor -%}
    </div>

    <div class="bp-main">
      {%- if main_img -%}
        {{ main_img | image_url: width: 1600 | image_tag: alt: alt_text, class: 'bp-main-img', loading: 'lazy' }}
      {%- else -%}
        <div class="bp-main-placeholder" aria-label="{{ alt_text }}">No image</div>
      {%- endif -%}
    </div>
  </div>

  <div class="bp-info">
    <h1 class="bp-title">{{ p.title | escape }}</h1>

    {%- capture price_block -%}
      {%- if p.price -%}
        {%- assign current_price = p.price -%}
        {%- assign compare_price = p.compare_at_price_max -%}
        <div class="bp-price">
          {%- if compare_price and compare_price > current_price -%}
            <div class="bp-price-now">{{ current_price | money_without_trailing_zeros }}</div>
            <div class="bp-price-was">{{ compare_price | money_without_trailing_zeros }}</div>
          {%- else -%}
            <div class="bp-price-now">{{ current_price | money_without_trailing_zeros }}</div>
          {%- endif -%}
        </div>
      {%- endif -%}
    {%- endcapture -%}
    {{- price_block -}}

    <div class="bp-row">
      <div class="bp-label">Select color</div>
      {%- if colors and colors != blank -%}
        <div class="bp-chips" data-color-list>
          {%- assign rendered = 0 -%}
          {%- for c in colors -%}
            {%- if c == blank -%}{%- continue -%}{%- endif -%}
            {%- if rendered >= 3 -%}{%- break -%}{%- endif -%}

            {%- assign rep_img = nil -%}
            {%- for v in p.variants -%}
              {%- assign hit = false -%}
              {%- if color_index == 0 and v.option1 == c -%}{%- assign hit = true -%}{%- endif -%}
              {%- if color_index == 1 and v.option2 == c -%}{%- assign hit = true -%}{%- endif -%}
              {%- if color_index == 2 and v.option3 == c -%}{%- assign hit = true -%}{%- endif -%}
              {%- if hit and v.image -%}{%- assign rep_img = v.image -%}{%- break -%}{%- endif -%}
            {%- endfor -%}
            {%- if rep_img == nil -%}{%- assign rep_img = p.featured_image -%}{%- endif -%}

            {%- assign qty_sum = 0 -%}
            {%- assign any_available = false -%}
            {%- for v in p.variants -%}
              {%- assign hit = false -%}
              {%- if color_index == 0 and v.option1 == c -%}{%- assign hit = true -%}{%- endif -%}
              {%- if color_index == 1 and v.option2 == c -%}{%- assign hit = true -%}{%- endif -%}
              {%- if color_index == 2 and v.option3 == c -%}{%- assign hit = true -%}{%- endif -%}
              {%- if hit -%}
                {%- if v.inventory_management -%}
                  {%- assign qty_sum = qty_sum | plus: (v.inventory_quantity | default: 0) -%}
                  {%- if v.inventory_quantity > 0 -%}{%- assign any_available = true -%}{%- endif -%}
                {%- else -%}
                  {%- if v.available -%}{%- assign any_available = true -%}{%- assign qty_sum = qty_sum | plus: 1 -%}{%- endif -%}
                {%- endif -%}
              {%- endif -%}
            {%- endfor -%}

            <button type="button"
              class="bp-chip bp-chip--color{% unless any_available %} is-oos{% endunless %}{% if forloop.first %} is-active{% endif %}"
              data-color="{{ c | escape }}"
              data-qty="{{ qty_sum }}"
              data-available="{{ any_available }}"
              aria-label="{{ c | escape }}">
              {{- rep_img | image_url: width: 24, height: 24, crop: 'center' | image_tag: alt: c, class: 'bp-chip-thumb' -}}
              <span class="bp-chip-label">{{ c | escape }}</span>
            </button>

            {%- assign rendered = rendered | plus: 1 -%}
          {%- endfor -%}
        </div>
      {%- else -%}
        <div class="bp-msg">No color options available</div>
      {%- endif -%}
    </div>

    <div class="bp-row">
      <div class="bp-label">Select size</div>
      <div class="bp-sizes" data-size-list></div>
    </div>

    <div class="bp-stock" data-stock
      data-not-available="Not available"
      data-available-with-count="Available: %{count}">
    </div>

    <a class="bp-cta" href="{{ p.url }}">View product</a>
  </div>
</div>

<script type="application/json" data-variant-matrix>{{ matrix_json | strip }}</script>

<style>
.bp-card{display:grid;grid-template-columns:1.2fr 1fr;gap:32px;border:1px solid #e5e7eb;border-radius:18px;padding:22px;background:#fff}
@media(max-width:1024px){.bp-card{grid-template-columns:1fr}}
.bp-media{display:grid;grid-template-columns:112px 1fr;gap:18px;align-items:start}
@media(max-width:680px){.bp-media{grid-template-columns:1fr}}
.bp-thumbs{display:flex;flex-direction:column;gap:12px}
.bp-thumb{border:1px solid #ececec;border-radius:12px;padding:6px;background:#fff;cursor:pointer;transition:box-shadow .15s}
.bp-thumb:hover{box-shadow:0 2px 10px rgba(0,0,0,.08)}
.bp-thumb.is-active{outline:2px solid #1f2937}
.bp-thumb-img{display:block;border-radius:8px}
.bp-main{position:relative;background:#f6f7f8;border-radius:16px;overflow:hidden;padding:10px}
.bp-main-img{width:100%;height:auto;display:block;object-fit:contain;border-radius:10px}
.bp-main-placeholder{display:flex;align-items:center;justify-content:center;min-height:300px;color:#666}
.bp-info{padding-top:6px}
.bp-title{font-size:32px;line-height:1.15;margin:0 0 10px}
.bp-price{display:flex;gap:12px;align-items:baseline;margin:6px 0 16px}
.bp-price-now{font-size:22px;font-weight:800}
.bp-price-was{font-size:16px;text-decoration:line-through;opacity:.6}
.bp-row{margin:16px 0 10px}
.bp-label{font-size:14px;opacity:.8;margin-bottom:8px}
.bp-chips{display:flex;flex-wrap:wrap;gap:12px}
.bp-chip{background:#fff;border:1.5px solid #e5e7eb;border-radius:12px;padding:8px 12px;cursor:pointer;transition:border-color .15s, box-shadow .15s;display:inline-flex;align-items:center;gap:8px}
.bp-chip.is-active{border-color:#111;box-shadow:0 2px 10px rgba(0,0,0,.06)}
.bp-chip.is-oos{opacity:.55;cursor:not-allowed}
.bp-chip-thumb{border-radius:6px;display:block}
.bp-chip-label{display:inline-block;line-height:1}
.bp-sizes{display:flex;flex-wrap:wrap;gap:10px;min-height:40px}
.bp-size{border:1.5px solid #e5e7eb;border-radius:10px;padding:8px 12px;background:#fff;cursor:pointer;transition:border-color .15s}
.bp-size.is-active{border-color:#111;box-shadow:0 2px 10px rgba(0,0,0,.06)}
.bp-size.is-oos{opacity:.5;cursor:not-allowed}
.bp-stock{min-height:22px;margin:8px 0 18px;font-size:14px;color:#111}
.bp-msg{font-size:14px;color:#b91c1c}
.bp-cta{display:block;width:100%;text-align:center;background:#111;color:#fff;text-decoration:none;border-radius:12px;padding:16px 18px;font-weight:700}
@media(max-width:480px){.bp-title{font-size:26px}.bp-price-now{font-size:20px}}
</style>

<script>
(function(){
  var root=(function(s){while(s&&!(s.previousElementSibling&&s.previousElementSibling.matches('.bp-card'))){s=s.previousElementSibling}return s?s.previousElementSibling:document.querySelector('.bp-card[data-banner="product"]') })(document.currentScript);
  if(!root) return;

  var mainImg=root.querySelector('.bp-main-img');
  var thumbs=[].slice.call(root.querySelectorAll('.bp-thumb'));
  thumbs.forEach(function(btn){ btn.addEventListener('click', function(){ thumbs.forEach(function(b){b.classList.remove('is-active')}); btn.classList.add('is-active'); var full=btn.getAttribute('data-full'); if(mainImg&&full){ mainImg.src=full; } }); });

  // matrix from JSON
  var matrixEl=root.nextElementSibling; if(!matrixEl || matrixEl.getAttribute('data-variant-matrix')===null){ matrixEl=document.querySelector('script[data-variant-matrix]'); }
  if(!matrixEl) return;
  var data=JSON.parse(matrixEl.textContent || '{}');
  var variants=data.variants||[];

  var colors=[].slice.call(root.querySelectorAll('.bp-chip.bp-chip--color'));
  var sizesWrap=root.querySelector('[data-size-list]');
  var stock=root.querySelector('[data-stock]');

  function fmt(q){ return (stock.getAttribute('data-available-with-count')||'Available: %{count}').replace('%{count}', q); }

  function unique(arr){ return arr.filter(function(v,i,a){ return a.indexOf(v)===i; }); }

  function renderSizes(color){
    if(!sizesWrap) return;
    var list=variants.filter(function(v){ return v.color===color; });
    var sizeValues=unique(list.map(function(v){ return v.size||''; })).filter(function(v){ return v!==''; });
    sizesWrap.innerHTML='';
    if(!sizeValues.length){
      // Якщо розмірів немає — показуємо єдиний «One size»
      var aggQty=list.reduce(function(s,v){return s+(v.qty||0)},0);
      var avail=aggQty>0 || list.some(function(v){return !!v.available});
      var btn=document.createElement('button');
      btn.type='button';
      btn.className='bp-size'+(avail?' is-active':' is-oos is-active');
      btn.textContent='One size';
      btn.dataset.qty=aggQty;
      btn.dataset.available=avail;
      sizesWrap.appendChild(btn);
      updateStock(btn);
      return;
    }
    sizeValues.forEach(function(sz,idx){
      var group=list.filter(function(v){ return v.size===sz; });
      var qty=group.reduce(function(s,v){return s+(v.qty||0)},0);
      var avail=(qty>0)||group.some(function(v){return !!v.available});
      var btn=document.createElement('button');
      btn.type='button';
      btn.className='bp-size'+(idx===0?' is-active':'')+(avail?'':' is-oos');
      btn.textContent=sz;
      btn.dataset.qty=qty;
      btn.dataset.available=avail;
      btn.addEventListener('click', function(){ 
        [].slice.call(sizesWrap.querySelectorAll('.bp-size')).forEach(function(b){ b.classList.remove('is-active'); });
        btn.classList.add('is-active');
        updateStock(btn);
      });
      sizesWrap.appendChild(btn);
    });
    var first=sizesWrap.querySelector('.bp-size'); if(first){ updateStock(first); }
  }

  function updateStock(btn){
    var qty=parseInt(btn.dataset.qty||'0',10);
    var avail=(btn.dataset.available==='true') || qty>0;
    if(!avail || qty<=0){ stock.textContent=stock.getAttribute('data-not-available')||'Not available'; }
    else{ stock.textContent=Number.isFinite(qty)&&qty>0 ? fmt(qty) : fmt('1+'); }
  }

  function activateColor(btn){
    colors.forEach(function(c){ c.classList.remove('is-active'); });
    btn.classList.add('is-active');
    var color=btn.getAttribute('data-color');
    // оновлюємо розміри для цього кольору
    renderSizes(color);
  }

  if(colors.length){
    // якщо випадково всі кольори з qty=0 — лишимо останній як 0 для демо-гілки «недоступно»
    var anyHasQty=[].some.call(colors, function(c){ return (parseInt(c.getAttribute('data-qty')||'0',10) > 0); });
    if(!anyHasQty){ var last=colors[colors.length-1]; if(last){ last.setAttribute('data-qty','0'); last.setAttribute('data-available','false'); } }
    // початковий вибір
    activateColor(colors[0]);
    colors.forEach(function(c){ c.addEventListener('click', function(){ if(c.classList.contains('is-oos')){ activateColor(c); } else { activateColor(c); } }); });
  }
})();
</script>
{%- endif -%}
